# Snowflake Connection Configuration
SNOWFLAKE_ACCOUNT=xy12345.us-east-1
SNOWFLAKE_USER=datamind_user
SNOWFLAKE_PASSWORD=your_snowflake_password_here
# Optional authentication alternatives:
# SNOWFLAKE_AUTHENTICATOR=externalbrowser
# SNOWFLAKE_PRIVATE_KEY_PATH=/path/to/rsa_key.p8
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=optional_passphrase

SNOWFLAKE_WAREHOUSE=DATAMIND_WH
SNOWFLAKE_DATABASE=SNOWFLAKE_SAMPLE_DATA
SNOWFLAKE_SCHEMA=TPCH_SF1
SNOWFLAKE_ROLE=DATAMIND_READONLY

# Ollama Model Configuration
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma3:1b

# DataMind Runtime Configuration
DATAMIND_DATASET=tpch
DATAMIND_MAX_ROWS=500
DATAMIND_QUERY_TIMEOUT_S=30
